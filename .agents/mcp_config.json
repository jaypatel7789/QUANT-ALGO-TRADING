{
  "mcpServers": {
    "multi-agent-grid": {
      "command": "f:/multi agent/venv/Scripts/python.exe",
      "args": [
        "f:/multi agent/core/mcp_server.py"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ],
      "env": {
        "AWS_MCP_PROXY_PROFILES": "agent-toolkit"
      }
    }
  }
}
