# ==========================================================
# OmniRoute & Multi-Agent Configuration
# ==========================================================

# OmniRoute AI Gateway Settings
OMNIROUTE_HOST=127.0.0.1
OMNIROUTE_PORT=20128
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_PASSWORD=admin123456

# Primary & Fallback Models (routed via OmniRoute)
PRIMARY_MODEL=claude-3-7-sonnet
SECONDARY_MODEL=gpt-4o
FALLBACK_MODEL=gemini-2.5-flash

# API Keys (Set the ones you use; OmniRoute routes to them)
# You can also configure them inside OmniRoute's web dashboard at http://localhost:20128
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# AutoGen (AG2) Execution Settings
WORKSPACE_DIR=f:/multi agent/workspace
EXECUTION_TIMEOUT=180
HUMAN_INPUT_MODE=NEVER

# Multi-Agent Dashboard Server Settings
DASHBOARD_HOST=0.0.0.0
AGENT_DASHBOARD_PORT=8090
